CLAUDE_API_KEY=YOUR_CLAUDE_API_KEY
REDIRECT_URL=https://localhost:3458/auth/callback
SHOPIFY_API_KEY=YOUR_APP_CLIENT_ID

# Delhivery One MCP - shipment tracking (https://one.delhivery.com)
D1_CLIENT_ID=YOUR_DELHIVERY_CLIENT_ID
D1_CLIENT_SECRET=YOUR_DELHIVERY_CLIENT_SECRET
D1_AUTH_URL=https://ucp-auth.delhivery.com/facelessvoid
D1_REALM=YOUR_DELHIVERY_REALM
D1_CLIENT_CMS=YOUR_DELHIVERY_CMS_CLIENT_ID
D1_MCP_URL=https://mcp-client.delhivery.com/mcp
# Optional: comma-separated Delhivery tools the chat agent may use ("*" for all).
# Defaults to read-only shipment tracking; the full dashboard includes wallet
# balances, support tickets and write actions that customers must not reach.
D1_ALLOWED_TOOLS=shipment-search,get-shipment-details-by-awb,get-awb-transit-history,get-sale-order
